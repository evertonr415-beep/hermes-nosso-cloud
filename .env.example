# Copie para .env e preencha no gerenciador de secrets da plataforma.
# NÃO faça commit do .env real.

# Dashboard / autenticação
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_PUBLIC_URL=
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# API Hermes
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=

# Providers
OPENAI_API_KEY=
MATRIX_API_KEY=

# Hermes Local opcional
HERMES_LOCAL_API_KEY=
HERMES_LOCAL_BASE_URL=
HERMES_LOCAL_MODEL=hermes-agent

# Bridge
HERMES_BRIDGE_KEY=
HERMES_SIMPLE_BRIDGE_KEY=
HERMES_UPSTREAM=http://hermes-cloud:8642
BRIDGE_PORT=9120

# Hermes Simples
PORT=9119
HERMES_SIMPLE_BRIDGE_UPSTREAM=http://hermes-bridge:9120
HERMES_ADVANCED_URL=http://localhost:9119

# Tailscale opcional
TS_BOOT_TIMEOUT=30m
TS_STATE_DIR=/var/lib/tailscale
TS_HOSTNAME=hermes-gateway
TS_AUTHKEY=
HERMES_LOCAL_TARGET=
