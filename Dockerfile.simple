FROM python:3.12-alpine
WORKDIR /app
RUN apk add --no-cache ffmpeg
RUN pip install --no-cache-dir gradio_client==2.0.3 pillow==11.3.0
COPY hermes-simple.py /app/hermes-simple.py
COPY patch-simple-media.py /tmp/patch-simple-media.py
COPY patch-image-reliability.py /tmp/patch-image-reliability.py
COPY patch-media-v2.py /tmp/patch-media-v2.py
COPY patch-video-media.py /tmp/patch-video-media.py
COPY patch-hybrid-mode.py /tmp/patch-hybrid-mode.py
COPY patch-attachment-ux.py /tmp/patch-attachment-ux.py
COPY patch-multimodal-attachment.py /tmp/patch-multimodal-attachment.py
COPY patch-owner-mode.py /tmp/patch-owner-mode.py
COPY patch-image-intent.py /tmp/patch-image-intent.py
COPY patch-real-person-reference.py /tmp/patch-real-person-reference.py
COPY patch-reference-search-fallback.py /tmp/patch-reference-search-fallback.py
COPY patch-private-auth.py /tmp/patch-private-auth.py
COPY fix-private-auth-patch.py /tmp/fix-private-auth-patch.py
COPY patch-persistent-media.py /tmp/patch-persistent-media.py
COPY patch-recover-lost-images.py /tmp/patch-recover-lost-images.py
RUN python /tmp/patch-simple-media.py \
 && python /tmp/patch-image-reliability.py \
 && python /tmp/patch-media-v2.py \
 && python /tmp/patch-video-media.py \
 && python /tmp/patch-hybrid-mode.py \
 && python /tmp/patch-attachment-ux.py \
 && python /tmp/patch-multimodal-attachment.py \
 && python /tmp/patch-owner-mode.py \
 && python /tmp/patch-image-intent.py \
 && python /tmp/patch-real-person-reference.py \
 && python /tmp/patch-reference-search-fallback.py \
 && python /tmp/fix-private-auth-patch.py \
 && python /tmp/patch-private-auth.py \
 && python /tmp/patch-persistent-media.py \
 && python /tmp/patch-recover-lost-images.py \
 && rm -f /tmp/patch-simple-media.py /tmp/patch-image-reliability.py /tmp/patch-media-v2.py /tmp/patch-video-media.py /tmp/patch-hybrid-mode.py /tmp/patch-attachment-ux.py /tmp/patch-multimodal-attachment.py /tmp/patch-owner-mode.py /tmp/patch-image-intent.py /tmp/patch-real-person-reference.py /tmp/patch-reference-search-fallback.py /tmp/patch-private-auth.py /tmp/fix-private-auth-patch.py /tmp/patch-persistent-media.py /tmp/patch-recover-lost-images.py
EXPOSE 9119
CMD ["python","/app/hermes-simple.py"]
