FROM python:3.12-alpine
WORKDIR /app
RUN apk add --no-cache ffmpeg
RUN pip install --no-cache-dir gradio_client==2.0.3 pillow==11.3.0
COPY hermes-simple.py /app/hermes-simple.py
COPY patch-simple-media.py /tmp/patch-simple-media.py
COPY patch-image-reliability.py /tmp/patch-image-reliability.py
COPY patch-media-v2.py /tmp/patch-media-v2.py
COPY patch-video-media.py /tmp/patch-video-media.py
COPY patch-hybrid-mode.py /tmp/patch-hybrid-mode.py
COPY patch-attachment-ux.py /tmp/patch-attachment-ux.py
COPY patch-multimodal-attachment.py /tmp/patch-multimodal-attachment.py
COPY patch-owner-mode.py /tmp/patch-owner-mode.py
COPY patch-image-intent.py /tmp/patch-image-intent.py
COPY patch-real-person-reference.py /tmp/patch-real-person-reference.py
COPY patch-reference-search-fallback.py /tmp/patch-reference-search-fallback.py
COPY patch-real-person-resilience.py /tmp/patch-real-person-resilience.py
COPY patch-real-people-grounded-skill.py /tmp/patch-real-people-grounded-skill.py
COPY patch-private-auth.py /tmp/patch-private-auth.py
COPY fix-private-auth-patch.py /tmp/fix-private-auth-patch.py
COPY patch-owner-cross-device-login.py /tmp/patch-owner-cross-device-login.py
COPY patch-persistent-media.py /tmp/patch-persistent-media.py
COPY patch-recover-lost-images.py /tmp/patch-recover-lost-images.py
COPY patch-cross-device-consistency.py /tmp/patch-cross-device-consistency.py
COPY patch-account-profile.py /tmp/patch-account-profile.py
COPY patch-paid-character-images.py /tmp/patch-paid-character-images.py
COPY patch-chat-resilience.py /tmp/patch-chat-resilience.py
COPY patch-local-profile-fallback.py /tmp/patch-local-profile-fallback.py
COPY patch-admin-rules.py /tmp/patch-admin-rules.py
COPY patch-admin-rules-indent-fix.py /tmp/patch-admin-rules-indent-fix.py
COPY patch-image-fidelity.py /tmp/patch-image-fidelity.py
COPY patch-antigravity.py /tmp/patch-antigravity.py
COPY patch-software-build-direct.py /tmp/patch-software-build-direct.py
RUN python /tmp/patch-simple-media.py \
 && python /tmp/patch-image-reliability.py \
 && python /tmp/patch-media-v2.py \
 && python /tmp/patch-video-media.py \
 && python /tmp/patch-hybrid-mode.py \
 && python /tmp/patch-attachment-ux.py \
 && python /tmp/patch-multimodal-attachment.py \
 && python /tmp/patch-owner-mode.py \
 && python /tmp/patch-image-intent.py \
 && python /tmp/patch-real-person-reference.py \
 && python /tmp/patch-reference-search-fallback.py \
 && python /tmp/patch-real-person-resilience.py \
 && python /tmp/patch-real-people-grounded-skill.py \
 && python /tmp/fix-private-auth-patch.py \
 && python /tmp/patch-private-auth.py \
 && python /tmp/patch-owner-cross-device-login.py \
 && python /tmp/patch-persistent-media.py \
 && python /tmp/patch-recover-lost-images.py \
 && python /tmp/patch-cross-device-consistency.py \
 && python /tmp/patch-account-profile.py \
 && python /tmp/patch-paid-character-images.py \
 && python /tmp/patch-chat-resilience.py \
 && python /tmp/patch-local-profile-fallback.py \
 && python /tmp/patch-admin-rules.py \
 && python /tmp/patch-admin-rules-indent-fix.py \
 && python /tmp/patch-image-fidelity.py \
 && python /tmp/patch-antigravity.py \
 && python /tmp/patch-software-build-direct.py \
 && rm -f /tmp/patch-simple-media.py /tmp/patch-image-reliability.py /tmp/patch-media-v2.py /tmp/patch-video-media.py /tmp/patch-hybrid-mode.py /tmp/patch-attachment-ux.py /tmp/patch-multimodal-attachment.py /tmp/patch-owner-mode.py /tmp/patch-image-intent.py /tmp/patch-real-person-reference.py /tmp/patch-reference-search-fallback.py /tmp/patch-real-person-resilience.py /tmp/patch-real-people-grounded-skill.py /tmp/patch-private-auth.py /tmp/fix-private-auth-patch.py /tmp/patch-owner-cross-device-login.py /tmp/patch-persistent-media.py /tmp/patch-recover-lost-images.py /tmp/patch-cross-device-consistency.py /tmp/patch-account-profile.py /tmp/patch-paid-character-images.py /tmp/patch-chat-resilience.py /tmp/patch-local-profile-fallback.py /tmp/patch-admin-rules.py /tmp/patch-admin-rules-indent-fix.py /tmp/patch-image-fidelity.py /tmp/patch-antigravity.py /tmp/patch-software-build-direct.py
EXPOSE 9119
CMD ["python","/app/hermes-simple.py"]
