FROM nousresearch/hermes-agent:latest

USER root

RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends nginx-light \
    && rm -rf /var/lib/apt/lists/*

COPY hermes-desktop-theme.css /opt/hermes/hermes_cli/web_dist/hermes-desktop-theme.css
COPY hermes-desktop-brand.js /opt/hermes/hermes_cli/web_dist/hermes-desktop-brand.js
COPY hermes-preview-nginx.conf /etc/nginx/nginx.conf

RUN python3 - <<'PY'
from pathlib import Path
p = Path("/opt/hermes/hermes_cli/web_dist/index.html")
text = p.read_text(encoding="utf-8")

style = '<link rel="stylesheet" href="/hermes-desktop-theme.css" />'
brand = '<script defer src="/hermes-desktop-brand.js"></script>'
bootstrap = (
    '<script>'
    'window.__HERMES_DASHBOARD_EMBEDDED_CHAT__=true;'
    'window.__HERMES_BASE_PATH__="";'
    'window.__HERMES_AUTH_REQUIRED__=true;'
    'window.__HERMES_INITIAL_PROFILE__="";'
    'window.__HERMES_DASHBOARD_PROFILE__="default";'
    '</script>'
)

if style not in text:
    text = text.replace("</head>", f"    {style}\n  </head>")
if bootstrap not in text:
    text = text.replace("<body>", f"<body>\n    {bootstrap}")
if brand not in text:
    text = text.replace("</body>", f"    {brand}\n  </body>")

text = text.replace("<title>Hermes Agent - Dashboard</title>", "<title>Hermes Nosso</title>")
p.write_text(text, encoding="utf-8")
PY

EXPOSE 9119
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
